NODE_ENV=development
POSTGRES_PASSWORD=change_me
# connection_limit=5 — маленький пул, чтобы Prisma не держала лишние соединения
DATABASE_URL=postgresql://bayern:change_me@127.0.0.1:5432/bayern_cards?connection_limit=5&pool_timeout=10
REDIS_URL=redis://127.0.0.1:6379
BOT_TOKEN=
WEBHOOK_SECRET=
WEBAPP_URL=https://your-domain.com
ADMIN_TELEGRAM_IDS=
AUTH_MAX_AGE_SECONDS=3600
DAILY_RESET_TZ=UTC
# Потолок кучи Node (МБ): процесс не раздувается сверх лимита
NODE_OPTIONS=--max-old-space-size=192
